# Copy to deploy/.env (`make env` does it) and change the values for your machine.
# docker-compose.yml reads this file; every backend setting that comes from the
# environment is listed here. Staging and production use their own copy with real secrets.

# --- Django ---------------------------------------------------------------
# config.settings.dev | config.settings.staging | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required on staging and production: a long random string, never shared.
DJANGO_SECRET_KEY=change-me-dev-only-secret-key
# Signs the API's JWT tokens. Required on staging and production (a different long
# random string from DJANGO_SECRET_KEY); in development it falls back to DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
# Comma-separated host names. Required on staging and production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
# Comma-separated origins with scheme, e.g. https://dental.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Staging and production only.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=
DJANGO_STATIC_ROOT=
# Reverse proxies in front of Django; the client IP is read from X-Forwarded-For.
# Leave empty for the default: 0 in development, 1 (nginx) in staging and production.
DJANGO_NUM_PROXIES=
LOG_LEVEL=INFO

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=spu_dental
POSTGRES_USER=spu_dental
POSTGRES_PASSWORD=spu_dental
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Redis: Celery broker (db 0) and cache (db 1) ------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# --- S3-compatible storage (Garage) --------------------------------------
S3_ENDPOINT_URL=http://storage:3900
S3_REGION=garage
# Garage key format: "GK" + 24 hex characters, secret 64 hex characters.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=spu-dental-media

# Garage node (development). Generate secrets with: openssl rand -hex 32
GARAGE_RPC_SECRET=4f1c2b3a5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708
GARAGE_ADMIN_TOKEN=dev-garage-admin-token
GARAGE_ADMIN_URL=http://storage:3903
GARAGE_CAPACITY_GB=10

# --- Email ----------------------------------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@localhost

# --- Push notifications (Firebase Cloud Messaging) -----------------------
# Path, inside the container, to the Firebase service account JSON file.
FIREBASE_CREDENTIALS_FILE=

# --- Host ports (docker-compose.yml only) --------------------------------
WEB_PORT=8000
DB_PORT=5432
STORAGE_PORT=3900

# --- Your user (docker-compose.yml only) ---------------------------------
# The Makefile fills these in. If you run `docker compose` yourself on Linux and
# your user id is not 1000, set them to the output of `id -u` and `id -g`.
# HOST_UID=1000
# HOST_GID=1000
